<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.p145.advancedsettings"
    android:versionCode="8"
    android:versionName="1.7">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="25" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_LOGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".GuardService"
            android:exported="false"
            android:stopWithTask="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter android:priority="1000">
                <!-- 标准开机 -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.REBOOT" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- 车机厂商自定义（这台车机不一定发标准 BOOT_COMPLETED，照 EVCC 收的那批广播） -->
                <action android:name="com.geely.intent.action.SYSTEM_READY" />
                <action android:name="com.geely.intent.action.WAKEUP" />
                <action android:name="com.ecarx.intent.action.SYSTEM_READY" />
                <action android:name="com.ecarx.intent.action.ACC_ON" />
                <action android:name="com.ecarx.intent.action.IGN_ON" />
                <action android:name="com.ecarx.intent.action.WAKEUP" />
                <action android:name="com.ecarx.intent.action.STR_RESUME" />
                <action android:name="com.ecarx.intent.action.POWER_ON" />
                <action android:name="com.ecarx.systemui.SYSTEM_UI_READY" />
                <action android:name="com.lynkco.intent.action.SYSTEM_READY" />
                <action android:name="com.lynkco.intent.action.WAKEUP" />
                <action android:name="com.lynkco.intent.action.STR_RESUME" />
                <action android:name="ecarx.intent.action.power.STRMODE" />
                <!-- 自定义触发 -->
                <action android:name="com.p145.adv.BOOT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".CmdReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.p145.advancedsettings.CMD" />
                <action android:name="com.p145.adv.CMD" />
                <action android:name="com.p145.adv.STATUS" />
                <action android:name="com.p145.adv.START" />
                <action android:name="com.p145.adv.STOP" />
                <action android:name="com.p145.adv.INJECT" />
                <action android:name="com.p145.adv.DETACH" />
                <action android:name="com.p145.adv.ICC_ON" />
                <action android:name="com.p145.adv.ICC_OFF" />
                <action android:name="com.p145.adv.VOL_ON" />
                <action android:name="com.p145.adv.VOL_OFF" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
